<Window x:Class="Lab3.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Lab3"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="5*" />
            <RowDefinition Height="10*" />
            <RowDefinition Height="62*" />
            <RowDefinition Height="15*" />
            <RowDefinition Height="8*" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="3*" />
            <ColumnDefinition Width="1*" />
        </Grid.ColumnDefinitions>
        <Menu Grid.ColumnSpan="2">
            <MenuItem Header="_File">
                <MenuItem Header="_New" Click="FileNew_Click"/>
                <MenuItem Header="_Load" Click="FileLoad_Click"/>
                <MenuItem Header="_Save" Click="FileSave_Click"/>
                <MenuItem Header="_Exit" Click="FileExit_Click"/>
            </MenuItem>
            <MenuItem Header="_Help">
                <MenuItem Header="_About" Click="FileAbout_Click"/>
            </MenuItem>
        </Menu>
        <TextBlock Name="numOfElemsText" Text="Number of elements:" Grid.Row="1" Margin="49,13,428,13"/>
        <TextBox Name="numOfElemsBox" Text="{Binding Path=numOfElemsBox}" Grid.Row="1" Margin="177,10,303,10" RenderTransformOrigin="0.45,0.527"/>
        <TextBox Name="rangeFromBox" Text="{Binding Path=rangeFromBox}" Grid.Row="1" Margin="402,10,78,10" RenderTransformOrigin="0.5,0.484"/>
        <TextBox Name="rangeToBox" Text="{Binding Path=rangeToBox}" Grid.Row="1" Margin="19,10,61,10" RenderTransformOrigin="0.183,0.613" Grid.Column="1"/>
        <TextBlock Text="Range from:" Grid.Row="1" Margin="312,13,203,13"/>
        <TextBlock Text="Range to:" Grid.Row="1" Margin="536,13,186,13" Grid.ColumnSpan="2"/>
        <Border Grid.Row="2" Margin="10,10,10,0" Grid.ColumnSpan="2" BorderBrush="Gray" BorderThickness="1">
            <TextBlock Name="outputBlock" Text="{Binding Path=outputBlock}" TextWrapping="Wrap"/>
        </Border>
        <ProgressBar Name="progrssBar1" Value="{Binding Path=progressBar1}" Grid.Row="3" Margin="10,10,10,10"/>
        <Button Name="start" Content="Start" Grid.Row="3" Grid.Column="1" Margin="0,10,10,10" Click="Button_ClickAsync"/>
        <StatusBar Name="sbar" Grid.Row="4" Grid.ColumnSpan="2">
            <StatusBarItem>
                <TextBlock Name="statusBarText" Text="{Binding Path=statusBarText}" />
            </StatusBarItem>
        </StatusBar>
    </Grid>
</Window>
